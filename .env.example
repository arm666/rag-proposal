# LLM backend priority: Ollama > OpenAI > Gemini.
# Set only the one(s) you want to use — the first configured provider wins.

# 1. Ollama — set OLLAMA_MODEL to use a local model.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma:latest

# 2. OpenAI — used when OPENAI_API_KEY is set (and OLLAMA_MODEL is not).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# 3. Gemini — used when GEMINI_API_KEY is set (and neither of the above is).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004


#OLLAMA_MODEL=llama3.2:latest
#OLLAMA_EMBED_MODEL=embeddinggemma:latest
#OLLAMA_BASE_URL=http://localhost:11434
