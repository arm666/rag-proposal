# LLM backend priority: Ollama > OpenAI > Gemini.
# Set only the one(s) you want to use — the first configured provider wins.

# 1. Ollama — set OLLAMA_MODEL to use a local model.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma:latest
# How long Ollama keeps a model resident in memory after the last request,
# in seconds ("-1" to keep it loaded indefinitely). Raising this avoids
# repeated cold-start model loads during back-to-back uploads/chats.
OLLAMA_KEEP_ALIVE=1800
# Concurrent chunk-extraction workers for Graph RAG ingestion. Defaults to 1
# for Ollama (most local servers handle one request at a time) and 4
# otherwise. Raise only if your Ollama server has OLLAMA_NUM_PARALLEL > 1.
GRAPH_EXTRACTION_WORKERS=1

# 2. OpenAI — used when OPENAI_API_KEY is set (and OLLAMA_MODEL is not).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# 3. Gemini — used when GEMINI_API_KEY is set (and neither of the above is).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# Graph RAG storage backend: Neo4j when NEO4J_URI is set, otherwise falls
# back to the local NetworkX+JSON pipeline (data/graph_index/<doc_id>/).
# Works with a local Neo4j instance (Desktop/Docker, e.g. neo4j://127.0.0.1:7687)
# or a Neo4j Aura cloud instance (neo4j+s://<id>.databases.neo4j.io).
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
